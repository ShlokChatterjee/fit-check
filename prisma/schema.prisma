// Wardrobe Agent — V1 schema (see Claude/implementation.md §2)
// Prisma 7 with the `prisma-client` generator; client is generated to
// app/generated/prisma (gitignored). Run `npx prisma generate` after edits.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js identity tables (owned by the Prisma adapter — do not hand-roll auth)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  wardrobeItems   WardrobeItem[]
  ingestionEvents IngestionEvent[]
  outfits         Outfit[]
  feedback        Feedback[]
  preference      Preference?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

enum Category {
  TOPS
  BOTTOMS
  SHOES
  OUTERWEAR
  ACCESSORIES
}

enum SourceType {
  DEVICE_UPLOAD
  GOOGLE_PHOTOS
}

enum IngestStatus {
  PENDING_REVIEW
  CONFIRMED
  DISCARDED
}

enum DetectionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model WardrobeItem {
  id          String   @id @default(cuid())
  userId      String
  category    Category
  name        String
  color       String?
  pattern     String?
  material    String?
  descriptors String[]
  imageUrl    String
  cropUrl     String?
  isFavorite  Boolean  @default(false)
  isActive    Boolean  @default(true) // deactivate = exclude from generation, keep history
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]

  @@index([userId, category])
}

model IngestionEvent {
  id        String       @id @default(cuid())
  userId    String
  source    SourceType
  imageUrl  String
  status    IngestStatus @default(PENDING_REVIEW)
  createdAt DateTime     @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  detections Detection[]

  @@index([userId])
}

model Detection {
  id            String          @id @default(cuid())
  eventId       String
  category      Category
  name          String
  color         String?
  descriptors   String[]
  confidence    Float
  cropUrl       String?
  status        DetectionStatus @default(PENDING)
  createdItemId String? // set when confirmed into a WardrobeItem

  event IngestionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Outfit {
  id          String   @id @default(cuid())
  userId      String
  request     String? // the natural-language request
  context     Json? // interpreted intent: occasion / weather / formality / descriptors
  explanation String? // AI-generated
  score       Float? // app-computed rank score
  createdAt   DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OutfitItem[]
  feedback Feedback?

  @@index([userId])
}

model OutfitItem {
  id             String   @id @default(cuid())
  outfitId       String
  wardrobeItemId String
  slot           Category

  outfit       Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  wardrobeItem WardrobeItem @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@index([outfitId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  outfitId  String   @unique
  liked     Boolean
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfit Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
}

model Preference {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json // inspectable weights: colors, categories, pairings
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
